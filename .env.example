# ===========================================
# PrimeHomes Real Estate Lead Bot - Environment
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Application
APP_ENV=development
APP_NAME=PrimeHomes Lead Bot
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_leads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security / Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider (example — adjust to your chosen provider)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Google Sheets (optional secondary reporting)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notifications (optional)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Logging
LOG_LEVEL=INFO
