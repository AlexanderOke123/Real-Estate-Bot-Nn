# ===========================================
# PrimeHomes Real Estate Lead Bot - Environment
# ===========================================
# Copy this file to .env (or backend/.env) and fill in real values.
# NEVER commit the real .env file.

# Application
APP_ENV=development
APP_NAME=PrimeHomes Lead Bot
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# MySQL (local development – no Docker needed)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/real_estate_leads

# Security / Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-process-message
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider (for later)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO
